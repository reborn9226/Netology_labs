[Unit]
Description=Node Explorer Курсовая работа - Ершов А.О.
After=network.target

[Service]
User=prometheus
Group=prometheus
Type=simple
AmbientCapabilities=CAP_PERFMON CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_PERFMON CAP_DAC_READ_SEARCH
ExecStart=/etc/prometheus/node-exporter/node_exporter \
    --collector.perf \
    --collector.perf.disable-hardware-profilers \
    --collector.perf.disable-software-profilers \
    --collector.perf.disable-cache-profilers \
    --collector.perf.tracepoint=mce:mce_record

[Install]
WantedBy=multi-user.target
