{
  "uid": "use-node-nginx",
  "title": "USE Metrics - Node & Nginx",
  "tags": [
    "ansible",
    "use",
    "nginx",
    "coursework"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "id": 100,
      "type": "stat",
      "title": "Статус экспортеров (Node Exporter :9100 и Nginx Log Exporter :9113)",
      "description": "Текущий успешный scrape: 1 UP, 0 DOWN.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=~\"node_exporter|nginx_exporter_log\",instance=~\"${host:regex}:[0-9]+\"}",
          "legendFormat": "{{job}} ({{instance}})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 3
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Сбор MCE: состояние коллектора perf",
      "description": "1 = perf успешно опрошен, 0 = сбор неуспешен/нет данных коллектора. Отсутствующий ряд - No data, не здоровый ноль. Проверять вместе с доступностью экспортера.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "node_scrape_collector_success{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\",collector=\"perf\"}",
          "legendFormat": "{{instance}} perf",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAIL / NO DATA",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 3
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "MCE - накопленный счетчик",
      "description": "Текущая сумма MCE по vCPU. Сбрасывается при перезапуске Node Exporter, это не счетчик за все время жизни ВМ. При отказе perf или scrape не подставляется ноль.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (instance) (node_perf_mce_mce_record{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\"}) and on(instance) (node_scrape_collector_success{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\",collector=\"perf\"} == 1) and on(instance) (up{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\"} == 1)",
          "legendFormat": "{{instance}} MCE total",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-06
              }
            ]
          },
          "mappings": [],
          "noValue": "Нет данных",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 3
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU · U - Утилизация процессора (%)",
      "description": "Не-idle время vCPU: формула включает iowait и steal. Для интерпретации сравнивать с PSI и отдельным steal. Пороги 70/85 % - учебные ориентиры, не универсальная норма.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            },
            "spanNulls": false
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU · S - Load1 на vCPU (косвенный показатель)",
      "description": "Load1 / число vCPU. Linux Load включает выполняющиеся/готовые задачи и непрерываемое ожидание, часто I/O. Это не чистая длина очереди CPU. Сопоставлять с CPU PSI.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            },
            "spanNulls": false
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "node_load1{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\"} / on(instance) count by (instance) (node_cpu_seconds_total{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\",mode=\"idle\"})",
          "legendFormat": "{{instance}} (Load1/vCPU)",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU · E - события Machine Check за 5 минут",
      "description": "События mce:mce_record, доступные гостевой ОС, сумма по vCPU. Это не CPU Steal и не полный контроль аппаратуры гипервизора. MCE может относиться также к кэшу/памяти. increase учитывает сброс счетчика и может давать дробное значение из-за экстраполяции. При отказе perf или scrape график не подменяется нулем.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-06
