  "panels": [
    {
      "id": 10,
      "type": "text",
      "title": "Как читать этот дашборд",
      "options": {
        "mode": "markdown",
        "content": "**U** - занятость ресурса; **S** - давление/очереди; **E** - ошибки.\n\nВыбор IP применяется к обоим экспортерам: Node Exporter `:9100`, Nginx Log Exporter `:9113`. Источник - `prometheus`, jobs - `node_exporter` и `nginx_exporter_log`.\n\n**No data не означает 0 ошибок.** Если PSI, OOM, скорость интерфейса или файловая статистика не экспортируются, надо проверить `/metrics` и доступность соответствующего collector. Не подменять отсутствующие данные нулями. Rates используют окно **5 минут**; после установки нужно накопить несколько scrape.\n\nПороги пробные, зависят от нагрузки. Потери сетевых пакетов - симптом, но не доказательство насыщения. Аппаратные ошибки CPU/RAM и физического диска облачный гипервизор может не отдавать. Нулевые OOM/ошибки ФС не доказывают исправность всей аппаратуры."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Доступность экспортёров (1 = UP, 0 = DOWN)",
      "description": "Последний результат scrape. Исчезнувший из конфигурации target не создает серию up=0: сверяй число источников с ожидаемым. При выборе All ожидаются четыре серии - два экспортёра на двух web-ВМ.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=~\"node_exporter|nginx_exporter_log\",instance=~\"${host:regex}:[0-9]+\"}",
          "legendFormat": "{{job}} / {{instance}}",
          "refId": "A",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 4
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU · U - использование (%)",
      "description": "Доля времени не в idle, усредненная по vCPU. Это не аппаратные ошибки CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 - 100 * avg by (instance) (rate(node_cpu_seconds_total{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\",mode=\"idle\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
