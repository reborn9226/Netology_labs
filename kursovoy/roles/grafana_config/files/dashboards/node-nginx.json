      "targets": [
        {
          "expr": "sum by (instance) (increase(node_perf_mce_mce_record{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\"}[5m])) and on(instance) (node_scrape_collector_success{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\",collector=\"perf\"} == 1) and on(instance) (up{job=\"node_exporter\",instance=~\"${host:regex}:[0-9]+\"} == 1)",
          "legendFormat": "{{instance}} MCE / 5 мин",
          "refId": "A"
        }
